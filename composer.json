{
    "name": "morningtrain/woocommerce-economic",
    "description": "This is a wrapper for integrating with e-conomic for woocommerce using the WP-Economic Package",
    "keywords": [
        "morningtrain",
        "woocommerce-economic",
        "econonmic",
        "woocommerce",
        "wordpress"
    ],
    "homepage": "https://github.com/morning-train/woocommerce-economic",
    "license": "MIT",
    "authors": [
        {
            "name": "Lars Rasmussen",
            "email": "laras@morningtrain.dk",
            "role": "Developer"
        },
        {
            "name": "Martin Schadegg Brønniche",
            "email": "ms@morningtrain.dk"
        }
    ],
    "require": {
        "php": "^8.1",
        "morningtrain/wp-economic": "^v1.2.0"
    },
    "require-dev": {
        "pestphp/pest": "^2.15",
        "laravel/pint": "^1.0",
        "spatie/ray": "^1.28"
    },
    "autoload": {
        "psr-4": {
            "Morningtrain\\WoocommerceEconomic\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Morningtrain\\WoocommerceEconomic\\Tests\\": "tests"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
